#!/bin/bash
# Every commit reads like the Spite language repository's: one gitmoji, a lowercase imperative summary, and the
# model that wrote it, so a bad change has an owner. Enforced rather than documented.

message_file="$1"

# Only the message counts: git's own comment lines and anything below the scissors line are dropped first.
message=$(sed -e '/^# -\{8,\} >8 -\{8,\}$/,$d' -e '/^#/d' "$message_file")
summary=$(printf '%s\n' "$message" | sed -n '/[^[:space:]]/{p;q;}')

reject() {
    printf '\n  commit rejected: %s\n\n' "$1" >&2
    printf '%s\n' "$2" | sed 's/^/  /' >&2
    printf '\n' >&2
    exit 1
}

# No em dashes, not the character and not two hyphens between spaces.
em_dash=$(printf '\342\200\224')
stand_in=' -''- '   # written in two pieces so this file does not contain what it refuses
if printf '%s\n' "$message" | grep -q -F -e "$em_dash" -e "$stand_in"; then
    reject "the message has an em dash" "Not the character, and not two hyphens between spaces standing in for one.
End the sentence, or use a colon, a comma or parentheses."
fi

# One gitmoji (one emoji, perhaps with a variation selector), one space, then a lowercase summary. Checked on bytes,
# so it holds where no UTF-8 locale is installed (Git for Windows has none named C.UTF-8).
emoji="${summary%% *}"
rest="${summary#* }"
variation_selector=$(printf '\357\270\217')
bare=$(printf '%s' "$emoji" | LC_ALL=C sed "s/$variation_selector//g")
characters=$(printf '%s' "$bare" | LC_ALL=C tr -d '\200-\277' | LC_ALL=C wc -c)
if [ -z "$emoji" ] || [ "$emoji" = "$summary" ] || printf '%s' "$emoji" | LC_ALL=C grep -q '[ -~]'     || [ "$characters" -ne 1 ] || ! printf '%s' "$rest" | LC_ALL=C grep -q '^[a-z]'; then
    reject "the summary is not one gitmoji and a lowercase summary" "Write it as:

    🐛 fix the reply size check"
fi

if ! grep -qE '^Co-authored-by: .+ <.+@.+>' "$message_file"; then
    reject "no Co-authored-by trailer" "Every commit ends with the model that wrote it:

    Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>

Name the model you are actually running as, not just \"Claude\". A human
committing by hand writes their own."
fi
exit 0
