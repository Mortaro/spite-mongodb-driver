var key = ""
var kind = 10
var text = ""
var whole: Long = 0
var decimal: Double = 0.0
var boolean = false
var document: Mongo.Document? = null

func Element(new_key: String, new_kind: Integer) {
    key = new_key
    kind = new_kind
}

func is_number(): Boolean {
    return kind == 1 or kind == 16 or kind == 18
}

func as_long(): Long {
    if kind == 1 {
        var rounded: Long = decimal
        return rounded
    }
    if kind == 8 and boolean {
        return 1
    }
    return whole
}

func as_double(): Double {
    if kind == 1 {
        return decimal
    }
    var number = as_long()
    var converted: Double = number
    return converted
}

func to_string(): String {
    switch kind {
        2: return "\"{text}\""
        7: return "ObjectId(\"{text}\")"
        1: return decimal
        8: return boolean
        9: return "Date({whole})"
        16: return whole
        18: return whole
        10: return "null"
        3: return embedded_text()
        4: return embedded_text()
        _: return "<type {kind}>"
    }
}

func embedded_text(): String {
    if not document {
        return ""
    }
    var shown = document
    if kind == 4 {
        return shown.array_text()
    }
    return shown.to_string()
}
