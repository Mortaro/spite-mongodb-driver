var raw = Raw()
var bson = Mongo.Bson()
var idle = List<Socket>()
var host = "127.0.0.1"
var port = 27017
var connected = false
var request_id = 0
var error = ""
var reply_limit = 50331648

func Client(new_host: String, new_port: Integer) {
    host = new_host
    port = new_port
}

func connect(): Boolean {
    var opened = open_connection()
    connected = false
    if opened {
        idle.append(opened)
        connected = true
    }
    return connected
}

func close() {
    idle.each_close()
    idle.clear()
    connected = false
}

func open_connection(): Socket? {
    var fresh = Socket()
    var opened = fresh.connect(host, port)
    if not opened {
        error = "could not connect to {host}:{port}"
    }
    assert opened
    return fresh
}

func take_connection(): Socket? {
    var reused = idle.remove_last()
    if reused {
        return reused
    }
    return open_connection()
}

func collection(database: String, name: String): Mongo.Collection {
    var found = Mongo.Collection()
    found.client = this
    found.database = database
    found.name = name
    return found
}

func drop_database(database: String): Boolean {
    var command = Mongo.Document()
    command.set_integer("dropDatabase", 1)
    var reply = run_command(database, command)
    if not reply {
        return false
    }
    return true
}

func run_command(database: String, command: Mongo.Document): Mongo.Document? {
    error = ""
    var reply = exchange(database, command)
    assert reply
    error = failure_of(reply)
    assert error.is_empty()
    return reply
}

func failure_of(reply: Mongo.Document): String {
    var ok = reply.double_of("ok")
    if ok != 1.0 {
        return reply_error(reply)
    }
    return write_error(reply)
}

func reply_error(reply: Mongo.Document): String {
    var message = reply.text_of("errmsg")
    if message.is_empty() {
        return "the command failed"
    }
    return message
}

func write_error(reply: Mongo.Document): String {
    var write_errors = reply.document_of("writeErrors")
    if not write_errors {
        return ""
    }
    var first = write_errors.elements.first()
    if not first {
        return ""
    }
    if not first.document {
        return ""
    }
    return first.document.text_of("errmsg")
}

func exchange(database: String, command: Mongo.Document): Mongo.Document? {
    var connection = take_connection()
    assert connection
    var message = request(database, command)
    var sent_id = raw.read_integer(message.address, 4)
    var sent = connection.write_bytes(message.address, message.length)
    if not sent {
        lose(connection, "could not send the command to {host}:{port}")
    }
    assert sent
    var reply = receive(connection, sent_id)
    if reply {
        idle.append(connection)
    }
    return reply
}

func request(database: String, command: Mongo.Document): Mongo.Bytes {
    var body = Mongo.Document()
    body.elements = command.elements.copy()
    body.set_text("$db", database)
    var message = Mongo.Bytes()
    request_id = request_id + 1
    message.write_integer(0)
    message.write_integer(request_id)
    message.write_integer(0)
    message.write_integer(2013)
    message.write_integer(0)
    message.write_byte(0)
    bson.encode(body, message)
    raw.write_integer(message.address, 0, message.length)
    return message
}

func receive(connection: Socket, sent_id: Integer): Mongo.Document? {
    var reply = Mongo.Bytes()
    reply.reserve(16)
    var header_read = read_exactly(connection, reply.address, 16)
    if not header_read {
        lose(connection, "the server closed the connection")
    }
    assert header_read
    var size = raw.read_integer(reply.address, 0)
    var response_to = raw.read_integer(reply.address, 8)
    var operation = raw.read_integer(reply.address, 12)
    var expected = size >= 26 and size <= reply_limit and response_to == sent_id and operation == 2013
    if not expected {
        lose(connection, "the server sent an unexpected reply")
    }
    assert expected
    reply.reserve(size)
    var body_at = reply.address + 16
    var body_read = read_exactly(connection, body_at, size - 16)
    if not body_read {
        lose(connection, "the server closed the connection")
    }
    assert body_read
    reply.length = size
    reply.position = 16
    var document = reply_body(reply)
    if not document {
        connection.close()
    }
    return document
}

func reply_body(reply: Mongo.Bytes): Mongo.Document? {
    reply.untrusted = true
    reply.read_integer()
    var kind = reply.read_byte()
    if kind != 0 {
        error = "the reply has no body section"
    }
    assert kind == 0
    var document = bson.decode(reply)
    if not document {
        error = "the reply is not valid BSON"
    }
    return document
}

func read_exactly(connection: Socket, address: Long, count: Integer): Boolean {
    var done = 0
    while done < count and not connection.closed {
        var at = address + done
        var received = connection.read_bytes(at, count - done)
        done = done + received
    }
    return done == count
}

func lose(connection: Socket, reason: String) {
    error = reason
    connection.close()
}

func drop() {
    close()
}
